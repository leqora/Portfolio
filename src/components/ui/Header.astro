---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300" data-header>
  <nav aria-label={t('nav.label')} class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href={lang === 'sr' ? '/sr/' : '/'} class="text-[0.95rem] font-semibold tracking-tight text-bone">
      Nikola Leleković
    </a>
    <div class="flex items-center gap-5 sm:gap-8">
      <ul class="hidden gap-7 text-sm text-ash sm:flex">
        <li><a class="link-line" href="#about">{t('nav.about')}</a></li>
        <li><a class="link-line" href="#projects">{t('nav.projects')}</a></li>
        <li><a class="link-line" href="#contact">{t('nav.contact')}</a></li>
      </ul>
      <a class="link-line text-sm text-ash sm:hidden" href="#contact">{t('nav.contact')}</a>
      <LangSwitcher />
    </div>
  </nav>
</header>

<script>
  // Give the header a backdrop only once the page has scrolled
  const header = document.querySelector<HTMLElement>('[data-header]');
  const update = () => {
    const scrolled = window.scrollY > 24;
    // Solid tint instead of backdrop blur: blurring a live WebGL canvas costs a full extra pass per frame
    header?.classList.toggle('bg-ink/92', scrolled);
    header?.classList.toggle('border-line', scrolled);
  };
  let last: boolean | null = null;
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    if (scrolled !== last) { last = scrolled; update(); }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
