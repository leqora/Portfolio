---
import { getLangFromUrl, type Lang } from '../../i18n/ui';
const current: Lang = getLangFromUrl(Astro.url);
const options: { lang: Lang; href: string; label: string; name: string }[] = [
  { lang: 'en', href: '/', label: 'EN', name: 'English' },
  { lang: 'sr', href: '/sr/', label: 'SR', name: 'Srpski' },
];
---
<div class="flex rounded-full border border-line p-0.5 text-xs font-semibold">
  {options.map((o) => (
    <a
      href={o.href}
      hreflang={o.lang}
      lang={o.lang}
      aria-label={o.name}
      aria-current={current === o.lang ? 'page' : undefined}
      class:list={[
        'rounded-full px-2.5 py-1 transition-colors',
        current === o.lang ? 'bg-bone text-ink' : 'text-ash hover:text-bone',
      ]}
    >
      {o.label}
    </a>
  ))}
</div>
