---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const email = 'nikola.lelekovic.rs@gmail.com';
---
<section id="contact" class="relative scroll-mt-20 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_100%,rgb(255_46_59/0.16),transparent_60%)]"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-36">
    <h2 class="display max-w-3xl text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02]">{t('contact.title')}</h2>
    <p class="mt-6 max-w-md text-lg text-ash">{t('contact.lead')}</p>

    <a
      href={`mailto:${email}`}
      class="group mt-14 inline-block break-all text-[clamp(1.15rem,4.6vw,3.6rem)] font-bold tracking-tight text-bone transition-colors hover:text-signal"
    >
      {email}
      <span class="mt-2 block h-px origin-left bg-line transition-colors group-hover:bg-signal"></span>
    </a>

    <p class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-2 text-ash">
      <span>{t('contact.elsewhere')}</span>
      <a class="link-line font-semibold text-bone" href="https://github.com/leqora" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link-line font-semibold text-bone" href="https://www.linkedin.com/in/nikola-lelekovi%C4%87/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </div>
</section>
