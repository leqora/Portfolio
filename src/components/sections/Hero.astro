---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import MonitorScene from '../islands/MonitorScene.tsx';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<!-- Extra height gives the camera room to fly into the screen while the hero is pinned -->
<section id="hero" class="relative motion-safe:h-[175svh]">
  <div class="relative flex min-h-[100svh] overflow-hidden motion-safe:sticky motion-safe:top-0 motion-safe:h-[100svh]">
  <!-- Glow shown while WebGL loads, and the whole effect when it can't run -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_22%,rgb(255_46_59/0.22),transparent_55%)] lg:bg-[radial-gradient(ellipse_at_72%_45%,rgb(255_46_59/0.2),transparent_50%)]"
  ></div>

  <MonitorScene client:only="react" />

  <!-- Keeps the copy readable where it overlaps the scene -->
  <div data-hero-fade class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink via-ink/80 to-transparent lg:hidden"></div>
  <div data-hero-fade class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-ink to-transparent"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-6xl items-end px-5 pb-14 pt-[50svh] sm:px-8 lg:items-center lg:pb-0 lg:pt-0">
    <div class="intro max-w-xl" data-hero-copy>
      <p class="mb-6 inline-flex items-center gap-2.5 text-sm text-ash">
        <span class="status-dot"></span>
        {t('hero.status')}
      </p>

      <h1 class="display text-[clamp(2.75rem,8.4vw,6.4rem)] text-bone">
        Nikola<br />Leleković
      </h1>

      <p class="mt-7 max-w-md text-base leading-relaxed text-ash sm:text-lg">
        {t('hero.lead')}
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#projects" class="btn btn-primary">{t('hero.cta.projects')}</a>
        <a href="mailto:nikola.lelekovic.rs@gmail.com" class="btn btn-ghost">{t('hero.cta.contact')}</a>
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  // Fade the copy out as the camera moves toward the screen
  const section = document.getElementById('hero');
  const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
  const scrims = document.querySelectorAll<HTMLElement>('[data-hero-fade]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (section && copy && !reduce) {
    const update = () => {
      const r = section.getBoundingClientRect();
      const travel = r.height - window.innerHeight;
      const p = travel > 0 ? Math.min(1, Math.max(0, -r.top / travel)) : 0;
      const fade = Math.min(1, p * 2.2);
      copy.style.opacity = String(1 - fade);
      copy.style.transform = `translateY(${-fade * 40}px)`;
      copy.style.pointerEvents = fade > 0.9 ? 'none' : '';
      // Lift the readability scrims too, so the screen is clear once it fills the view
      scrims.forEach((el) => (el.style.opacity = String(1 - Math.min(1, p * 1.6))));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
