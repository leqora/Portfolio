---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { filterByLang, sortProjects } from '../../lib/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('projects');
const entries = sortProjects(filterByLang(all.map((e) => e.data), lang));
---
<section id="projects" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32">
  <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)]">{t('projects.title')}</h2>

  <ul class="mt-14 border-b border-line">
    {entries.map((p) => (
      <li class="group relative grid gap-4 border-t border-line py-9 transition-colors hover:bg-carbon/60 sm:px-4 md:grid-cols-12 md:gap-8">
        <!-- Red edge marks the row under the pointer -->
        <span class="absolute inset-y-0 left-0 w-px origin-top scale-y-0 bg-signal transition-transform duration-300 group-hover:scale-y-100"></span>
        <h3 class="text-2xl font-semibold tracking-tight [font-stretch:115%] md:col-span-4">{p.title}</h3>
        <div class="md:col-span-6">
          <p class="max-w-prose text-ash">{p.description}</p>
          <p class="mt-3 text-sm text-bone/70">{p.tags.join(', ')}</p>
        </div>
        <div class="flex gap-5 text-sm font-semibold md:col-span-2 md:flex-col md:items-end md:gap-2">
          {p.github && (
            <a class="link-line text-bone/90" href={p.github} target="_blank" rel="noopener noreferrer">
              {t('projects.github')}<span class="sr-only"> — {p.title}</span>
            </a>
          )}
          {p.live && (
            <a class="link-line text-signal" href={p.live} target="_blank" rel="noopener noreferrer">
              {t('projects.live')}<span class="sr-only"> — {p.title}</span>
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
