---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experience = [
  {
    role: 'Azure Integration Engineer',
    company: 'CHC Helicopter',
    start: { en: 'Dec 2025', sr: 'Dec 2025' },
    note: {
      en: 'Migrating BizTalk orchestrations to Azure Logic Apps. Remote.',
      sr: 'Migracija BizTalk orkestracija na Azure Logic Apps. Remote.',
    },
  },
  {
    role: 'Software Engineer',
    company: 'Binary Consulting Belgrade',
    start: { en: 'May 2024', sr: 'Maj 2024' },
    note: {
      en: 'Backend services and Web APIs in C# and ASP.NET.',
      sr: 'Backend servisi i Web API-ji u C# i ASP.NET-u.',
    },
  },
];

const stack = [
  { group: 'Backend', items: ['C#', '.NET', 'ASP.NET Core', 'Blazor', 'Spring Boot'] },
  { group: lang === 'sr' ? 'Cloud i integracije' : 'Cloud and integration', items: ['Azure', 'Logic Apps', 'BizTalk', 'Docker'] },
  { group: lang === 'sr' ? 'Baze' : 'Data', items: ['SQL Server', 'MongoDB', 'MySQL'] },
  { group: 'Frontend', items: ['React', 'Next.js', 'TypeScript'] },
];
---
<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02] lg:sticky lg:top-28">
        {t('about.title')}
      </h2>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <p class="max-w-prose text-lg leading-relaxed text-ash">{t('about.bio')}</p>

      <h3 class="mt-16 text-sm font-semibold text-bone">{t('about.experience')}</h3>
      <ol class="relative mt-6 border-l border-line">
        {experience.map((e) => (
          <li class="relative pb-10 pl-8 last:pb-0">
            <span class="absolute -left-[5px] top-2 h-[9px] w-[9px] rounded-full bg-signal shadow-[0_0_0_4px_var(--color-ink),0_0_14px_rgb(255_46_59/0.7)]"></span>
            <p class="text-sm text-ash">{e.start[lang]} – {t('about.present')}</p>
            <p class="mt-1 text-xl font-semibold text-bone">{e.role}</p>
            <p class="text-bone/80">{e.company}</p>
            <p class="mt-2 text-ash">{e.note[lang]}</p>
          </li>
        ))}
      </ol>

      <h3 class="mt-16 text-sm font-semibold text-bone">{t('about.skills')}</h3>
      <dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {stack.map((s) => (
          <div class="border-t border-line pt-4">
            <dt class="text-sm text-ash">{s.group}</dt>
            <dd class="mt-1.5 text-bone">{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
